# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.
# Server-only: nothing here is exposed to the browser (no NEXT_PUBLIC_ variables are used).

# Public URL of this app (used for CSRF origin checks, auth redirects and share links)
APP_URL=http://localhost:3000

# Supabase project → Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key bypasses RLS. Used only by the job worker, file ledger, invite redemption and rate limiting.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudflare R2 — uploaded statements (S3-compatible API).
# R2 → Manage API tokens → Create token with "Object Read & Write" scoped to the bucket below.
R2_ACCOUNT_ID=8c7ffa4fbbf03d291db6fd9584488963
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=expense-statements
# Only for EU/FedRAMP jurisdiction buckets, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Protects /api/v1/jobs/run. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

LOG_LEVEL=info

# --- LLM providers (all optional; configure only the ones you use) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Admin-approved Ollama endpoints as name=url pairs, comma separated, each ending in /api.
# Users choose by name, never by URL.
#   local dev:      local=http://localhost:11434/api
#   Ollama Cloud:   cloud=https://ollama.com/api   (needs OLLAMA_API_KEY; counts as cloud processing)
#   your server:    gpu=https://ollama.example.com/api
# On Vercel, localhost is Vercel's own machine, so use Ollama Cloud or your own server there.
# Shortcut: leave OLLAMA_ENDPOINTS empty and set only OLLAMA_API_KEY to use Ollama Cloud.
OLLAMA_ENDPOINTS=local=http://localhost:11434/api
# Bearer token sent to the endpoint(s): an ollama.com API key, or your gateway's token
OLLAMA_API_KEY=
