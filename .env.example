# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.
# Server-only: nothing here is exposed to the browser (no NEXT_PUBLIC_ variables are used).

# Public URL of this app (used for CSRF origin checks, auth redirects and share links)
APP_URL=http://localhost:3000

# Supabase project → Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key bypasses RLS. Used only by the job worker, invite redemption and rate limiting.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Protects /api/v1/jobs/run. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

LOG_LEVEL=info

# --- LLM providers (all optional; configure only the ones you use) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Admin-approved Ollama endpoints as name=url pairs (users choose by name, never by URL).
# A deployed app cannot reach localhost on your laptop: host Ollama behind an authenticated gateway.
OLLAMA_ENDPOINTS=local=http://localhost:11434/api
# Optional bearer token sent to the Ollama gateway
OLLAMA_API_KEY=
